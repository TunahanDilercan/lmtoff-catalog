# Bu dosyayı "keystore.properties" olarak kopyalayıp kendi imzalama
# bilgilerinizi girin. keystore.properties git'e commit EDİLMEZ.
#
#   cp keystore.properties.example keystore.properties
#
# Dosya yoksa release build otomatik olarak debug keystore ile imzalanır;
# bu yalnızca yerel test içindir, dağıtım için kullanılmaz.

storeFile=/path/to/lmtoff-release.jks
storePassword=CHANGE_ME
keyAlias=lmtoff
keyPassword=CHANGE_ME
